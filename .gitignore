.project
.recommenders

# ── Python (scripts/ и tools/ запускаются на месте) ───────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
