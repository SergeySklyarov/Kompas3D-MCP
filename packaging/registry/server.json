{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SergeySklyarov/kompas3d-mcp",
  "description": "Drive a licensed KOMPAS-3D v24 x64 via COM: parts, assemblies, drawings, BOM, STEP/DXF export.",
  "title": "KompasMCP - KOMPAS-3D v24",
  "repository": { "url": "https://github.com/SergeySklyarov/Kompas3D-MCP", "source": "github" },
  "version": "@VERSION@",
  "websiteUrl": "https://github.com/SergeySklyarov/Kompas3D-MCP",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "@MCPB_URL@",
      "version": "@VERSION@",
      "fileSha256": "@MCPB_SHA256@",
      "transport": { "type": "stdio" }
    }
  ]
}
