    "document_id"
  ],
  "$defs": {
    "document_id": {
      "type": "string",
      "description": "UUID \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u0438\u0437 kompas_create_document/kompas_open_document; \u00AB\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u00BB \u043D\u0435\u0442.",
      "pattern": "^[0-9a-f]{32}$"
    },
    "timeout_ms": {
      "type": "integer",
      "description": "\u0411\u044E\u0434\u0436\u0435\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439. \u0418\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0442\u0430\u0439\u043C-\u0430\u0443\u0442\u0430 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0438\u0441\u0445\u043E\u0434, \u0430 \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u0443.",
      "minimum": 1000,
