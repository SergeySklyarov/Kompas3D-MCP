      "items": {
        "type": "string",
        "description": "\u0421\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0438\u0437 kompas_list_components."
      },
      "description": "\u041F\u0430\u0440\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0441\u043F\u0438\u0441\u043A\u0443. \u041D\u0435 \u0437\u0430\u0434\u0430\u043D \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E\u0442\u0441\u044F \u0432\u0441\u0435 \u0430\u0434\u0440\u0435\u0441\u0443\u0435\u043C\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u0432\u0435\u0440\u0445\u043D\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F. \u041D\u0443\u0436\u043D\u043E \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u0434\u0432\u0443\u0445 \u0420\u0410\u0417\u041D\u042B\u0425 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432.",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true
    },
    "check_tangent": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "\u0421\u0447\u0438\u0442\u0430\u0442\u044C \u043A\u0430\u0441\u0430\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u044F\u043C\u0438. \u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E false.",
      "default": false
    },
    "include_faces": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "\u0414\u043E\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u043D\u043E\u043C\u0435\u0440\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u043C\u044B\u0445 \u0438 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445 \u0433\u0440\u0430\u043D\u0435\u0439 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u0435\u043B\u0430.",
      "default": false
    },
    "timeout_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/timeout_ms"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
