    "pitch_mm": {
      "type": "number",
      "description": "\u0428\u0430\u0433 \u0440\u0435\u0437\u044C\u0431\u044B, \u043C\u043C; \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E \u003E 0. \u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442 \u0438 \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u0448\u0430\u0433\u043E\u0432 \u0432 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u043D\u0435 \u0432\u0445\u043E\u0434\u044F\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0448\u0430\u0433 \u0437\u0430\u0434\u0430\u0451\u0442 \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0439.",
      "minimum": 0,
      "maximum": 1000000
