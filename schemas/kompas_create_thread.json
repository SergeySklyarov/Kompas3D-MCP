    "length_mm": {
      "type": [
        "number",
        "null"
      ],
      "description": "\u0414\u043B\u0438\u043D\u0430 \u0440\u0435\u0437\u044C\u0431\u044B, \u043C\u043C. \u041B\u0438\u0431\u043E \u044D\u0442\u043E \u043F\u043E\u043B\u0435, \u043B\u0438\u0431\u043E auto_length.",
      "minimum": 0,
      "maximum": 1000000
