      ],
      "description": "\u0411\u0430\u0437\u0430 - \u043A\u0440\u0443\u0433\u043E\u0432\u043E\u0435 \u0440\u0435\u0431\u0440\u043E \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0430 (\u0441\u0441\u044B\u043B\u043A\u0430 edge:). \u0412\u0437\u0430\u0438\u043C\u043E\u0438\u0441\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0435 \u0441 face_ref: \u043E\u0431\u0435 \u0444\u043E\u0440\u043C\u044B \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 - INVALID_ARGUMENT \u0434\u043E COM."
    },
    "face_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "\u0411\u0430\u0437\u0430 - \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0433\u0440\u0430\u043D\u044C (\u0441\u0441\u044B\u043B\u043A\u0430 face:). \u0422\u043E\u0433\u0434\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B. \u041A\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0433\u0440\u0430\u043D\u044C \u0432 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442."
    },
    "initial_border_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "\u0413\u0440\u0430\u043D\u044C, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0435\u0437\u044C\u0431\u0430. \u041F\u0440\u0438 \u0431\u0430\u0437\u0435-\u0433\u0440\u0430\u043D\u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430."
    },
    "final_border_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "\u0413\u0440\u0430\u043D\u044C, \u0434\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0438\u0434\u0451\u0442 \u0440\u0435\u0437\u044C\u0431\u0430. \u041F\u0440\u0438 \u0431\u0430\u0437\u0435-\u0433\u0440\u0430\u043D\u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430; \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0434\u0430\u0451\u0442 \u0434\u043B\u0438\u043D\u0443 \u043F\u0440\u0438 auto_length."
