{
  "type": "object",
  "title": "\u041A\u043E\u043D\u0442\u0435\u043A\u0441\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430",
  "properties": {
    "document_id": {
      "$ref": "#/$defs/document_id"
    },
    "detail": {
      "type": "string",
      "description": "minimal \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0447\u0451\u0442\u0447\u0438\u043A\u0438; full \u2014 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0433\u0430\u0431\u0430\u0440\u0438\u0442 \u0438 \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u0413\u0430\u0431\u0430\u0440\u0438\u0442 \u0438\u0434\u0451\u0442 \u0414\u0412\u0423\u041C\u042F \u0431\u043B\u043E\u043A\u0430\u043C\u0438 \u0441 \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u044C\u044E: gabarit.full \u2014 \u0432\u0435\u0441\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442-\u043C\u043E\u0434\u0435\u043B\u044C (\u044D\u0441\u043A\u0438\u0437\u044B \u0438 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u044B), gabarit.bodies \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u043B\u043E\u0448\u043D\u044B\u0435 \u0442\u0435\u043B\u0430 (\u0441\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u0442\u044C \u0441 list_bodies). \u042D\u0442\u043E \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B: \u044D\u0441\u043A\u0438\u0437 \u0432\u043D\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 full \u0438 \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 bodies. \u041E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F (fingerprint) \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D \u043F\u043E full \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u0442\u043E\u0436\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u0435\u043D \u043A \u044D\u0441\u043A\u0438\u0437\u0430\u043C.",
      "enum": [
        "minimal",
        "full"
      ]
    },
    "timeout_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/timeout_ms"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "document_id",
    "detail"
  ],
  "$defs": {
    "document_id": {
      "type": "string",
      "description": "UUID \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u0438\u0437 kompas_create_document/kompas_open_document. \u041D\u0438 \u043E\u0434\u043D\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u00AB\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u00BB.",
      "pattern": "^[0-9a-f]{32}$"
    },
    "timeout_ms": {
      "type": "integer",
      "description": "\u0411\u044E\u0434\u0436\u0435\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439. \u041D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u0435\u043C\u0430\u043D\u0442\u0438\u043A\u0443 \u043E\u0442\u043C\u0435\u043D\u044B: \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0442\u0430\u0439\u043C-\u0430\u0443\u0442\u0430 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0438\u0441\u0445\u043E\u0434, \u0430 \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u0443.",
      "minimum": 1000,
      "maximum": 600000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}