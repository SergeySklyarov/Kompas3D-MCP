    "inertia_units": {
      "type": [
        "string",
        "null"
      ],
      "description": "\u0415\u0434\u0438\u043D\u0438\u0446\u044B \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u0432 \u0438\u043D\u0435\u0440\u0446\u0438\u0438 (\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u043C inertia): mm_kg \u2014 \u0434\u043B\u0438\u043D\u0430 \u0432 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0432 \u043A\u0433 (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E); m_kg \u2014 \u0434\u043B\u0438\u043D\u0430 \u0432 \u043C, \u043C\u0430\u0441\u0441\u0430 \u0432 \u043A\u0433. \u0415\u0434\u0438\u043D\u0438\u0446\u0430 \u2014 \u0410\u0420\u0413\u0423\u041C\u0415\u041D\u0422 \u0432\u044B\u0437\u043E\u0432\u0430: \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u0441 m_kg \u043C\u0435\u043D\u044C\u0448\u0435 \u0432 1e6 \u0440\u0430\u0437 (\u043A\u0432\u0430\u0434\u0440\u0430\u0442 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0434\u043B\u0438\u043D), \u0438 \u0431\u043B\u043E\u043A inertia \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u0451\u043D\u043D\u0443\u044E \u0435\u0434\u0438\u043D\u0438\u0446\u0443 \u0432 \u043F\u043E\u043B\u0435 units.",
