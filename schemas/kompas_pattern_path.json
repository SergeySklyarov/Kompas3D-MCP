    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "description": "\u041A\u043E\u043F\u0438\u0440\u0443\u0435\u043C\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B: component:-\u0441\u0441\u044B\u043B\u043A\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432 \u0412\u0415\u0420\u0425\u041D\u0415\u0413\u041E \u0443\u0440\u043E\u0432\u043D\u044F \u044D\u0442\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0438. \u041F\u0443\u0441\u0442\u043E\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u043E\u0442\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F \u0434\u043E \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043A \u041A\u041E\u041C\u041F\u0410\u0421.",
      "minItems": 1
    },
    "curve_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "description": "\u0422\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044F: \u0420\u041E\u0412\u041D\u041E \u041E\u0414\u041D\u0410 \u0441\u0441\u044B\u043B\u043A\u0430 edge: \u043D\u0430 \u0440\u0435\u0431\u0440\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430 (kompas_read_topology \u0441 component_ref). \u042D\u0441\u043A\u0438\u0437 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F - \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u043E. \u041F\u0443\u0441\u0442\u043E\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u043E\u0442\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F; \u0432\u0442\u043E\u0440\u0430\u044F \u043A\u0440\u0438\u0432\u0430\u044F \u043E\u0442\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F \u0441\u0445\u0435\u043C\u043E\u0439 (maxItems=1, INVALID_ARGUMENT), \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u0448\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043A\u0440\u0438\u0432\u044B\u0445 \u0432 \u043E\u0434\u043D\u0443 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E \u043D\u0435 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u043E, \u0430 \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0441\u043B\u043E\u0439 \u043D\u0430 \u0442\u043E\u0442 \u0436\u0435 \u0432\u0445\u043E\u0434 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 CAPABILITY_UNAVAILABLE, \u0435\u0441\u043B\u0438 \u0437\u0430\u043F\u0440\u043E\u0441 \u043F\u0440\u0438\u0448\u0451\u043B \u043C\u0438\u043C\u043E \u0441\u0445\u0435\u043C\u044B.",
      "minItems": 1,
      "maxItems": 1
    },
    "count": {
      "type": "integer",
      "description": "\u0427\u0438\u0441\u043B\u043E \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u043E\u0432 \u0412\u041A\u041B\u042E\u0427\u0410\u042F \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 (IPathPattern.Count). \u041D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 2: \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u043C \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0435 \u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E.",
      "minimum": 2,
      "maximum": 100000
    },
    "step_mm": {
      "type": [
        "number",
        "null"
      ],
      "description": "\u0428\u0430\u0433 \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438, \u043C\u043C. \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D \u043F\u0440\u0438 by_step=true; \u043F\u0440\u0438 by_step=false \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0448\u0430\u0433 \u0442\u0430\u043C \u0432\u044B\u0447\u0438\u0441\u043B\u044F\u0435\u0442 \u043C\u043E\u0434\u0435\u043B\u044C \u0438\u0437 \u0434\u043B\u0438\u043D\u044B \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0438 \u0447\u0438\u0441\u043B\u0430 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u043E\u0432.",
      "maximum": 1000000000,
      "exclusiveMinimum": 0
    },
    "by_step": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F (IPathPattern.ByStep): true - \u043F\u043E \u0448\u0430\u0433\u0443, false - \u0432\u0434\u043E\u043B\u044C \u0432\u0441\u0435\u0439 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439, \u043A\u0440\u0430\u0439\u043D\u0438\u0435 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u044B \u043D\u0430 \u0435\u0451 \u043A\u043E\u043D\u0446\u0430\u0445 (\u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 ipathpattern_bystep.html). \u041D\u0435 \u0437\u0430\u0434\u0430\u043D\u043E - true.",
      "default": true
    },
    "reverse_direction": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "\u041E\u0431\u0440\u0430\u0442\u043D\u043E\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 (IPathPattern.ReverseDirection). \u041D\u0435 \u0437\u0430\u0434\u0430\u043D\u043E - false."
    },
    "save_initial_orientation": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "\u041E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u043E\u0432 (IPathPattern.SaveInitialOrientation): true - \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E \u0438\u0441\u0445\u043E\u0434\u043D\u0438\u043A\u0430, false - \u0434\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C \u043A \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438. \u041D\u0435 \u0437\u0430\u0434\u0430\u043D\u043E - true, \u0438 \u044D\u0442\u043E \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C: \u043F\u0440\u0438 false \u043D\u0430\u0431\u043E\u0440 \u043D\u0430\u0447\u0430\u043B \u0438\u0437 \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u043D\u0435 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u0441\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0432\u0435\u0440\u043A\u0430 \u0441\u043C\u0435\u0449\u0435\u043D\u0438\u0439 \u0441\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0430 \u0432 unverified_aspects.",
      "default": true
    },
