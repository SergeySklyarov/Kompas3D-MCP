<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One-off measurement probe for ASSEMBLY_CHECKPOINT attempt 3 (remarks §1: M1-M5, two routes).
    INVARIANT: this project is NOT in KompasMcp.sln and references nothing in src/ - it measures what
    KOMPAS answers on the two documented routes, not what the product does with them.
    DOC: .cycle/remarks/ASSEMBLY_CHECKPOINT-2.md §1; reference/kompas-sdk-v24/docs-wire-20261028-e5/
    History: docs/decisions/scenario.md#assembly-checkpoint
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AscProbe</RootNamespace>
    <AssemblyName>AscProbe</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Kompas6API5">
      <HintPath>$(KompasInteropDir)\Interop.Kompas6API5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Kompas6Constants">
      <HintPath>$(KompasInteropDir)\Interop.Kompas6Constants.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Kompas6Constants3D">
      <HintPath>$(KompasInteropDir)\Interop.Kompas6Constants3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KompasAPI7">
      <HintPath>$(KompasInteropDir)\Interop.KompasAPI7.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KompasInteropDir" Value="$(KompasInteropDir)" />
  </ItemGroup>

  <Target Name="ThrowWhenInteropMissing" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(KompasInteropDir)\Interop.KompasAPI7.dll')"
           Text="Не найден Interop.KompasAPI7.dll в '$(KompasInteropDir)'. Укажите корень установки: dotnet build -p:KompasRoot=..." />
  </Target>

</Project>
