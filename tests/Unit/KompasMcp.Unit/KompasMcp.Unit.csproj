<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deterministic tests: no КОМПАС, no file system outside a temp dir. These cover the logic
       the CAD lane cannot substitute for — validation, transforms, journal, queue, path policy. -->
  <PropertyGroup>
    <RootNamespace>KompasMcp.Unit</RootNamespace>
    <AssemblyName>KompasMcp.Unit</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\KompasMcp.Domain\KompasMcp.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\KompasMcp.Contracts\KompasMcp.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\KompasMcp.Host\KompasMcp.Host.csproj" />
  </ItemGroup>

  <!-- The client contour of card GAP-012 (CP04a): 21 arcs and 4 lines, embedded so the area test is
       deterministic and needs no file system at run time. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\plate_cp04a_mcp.json" />
  </ItemGroup>

  <!-- The client part of card OBS-026 (Omega CP06, 3004019): the pinion contour that was refused and the
       escape wheel contour that was extruded. Verbatim copy, so the profile diagnosis is measured on the
       contour the client actually sent rather than on a figure built to suit the detector. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\wheels_cp05_3004019.json" />
  </ItemGroup>

</Project>
