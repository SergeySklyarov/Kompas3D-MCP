    <RootNamespace>KompasMcp.Unit</RootNamespace>
    <AssemblyName>KompasMcp.Unit</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\KompasMcp.Domain\KompasMcp.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\KompasMcp.Contracts\KompasMcp.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\KompasMcp.Host\KompasMcp.Host.csproj" />
  </ItemGroup>

</Project>
